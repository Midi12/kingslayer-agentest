# Copy to .env (git-ignored) or export in your shell.

# Registry mirror for Docker Hub images in compose.dev.yaml and the Dockerfiles.
# Docker Hub pulls are rate-limited; this build host uses mirror.gcr.io.
DOCKERHUB_MIRROR=mirror.gcr.io

# A CA bundle for networks that re-terminate TLS. M00-G1 passes it to the toolchain
# image build as a secret and mounts it read-only into the clean-clone container.
# NODE_EXTRA_CA_CERTS=/path/to/ca-bundle.pem

# Tier B credentials; without them every Tier B gate reports not_run (ADR-0016).
# TYPESAFE_API_KEY=
# ARGUS_LLM_API_KEY=
