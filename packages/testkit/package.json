{
  "name": "@argus/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Test support for ARGUS: the Tier A network guard, gate metrics, the shared Vitest preset, the Jev and LLM fakes, cassettes and in-memory port fakes",
  "exports": {
    ".": {
      "@argus/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./network-guard": {
      "@argus/source": "./src/network-guard.ts",
      "types": "./dist/network-guard.d.ts",
      "default": "./dist/network-guard.js"
    },
    "./network-guard/setup": {
      "@argus/source": "./src/network-guard.setup.ts",
      "types": "./dist/network-guard.setup.d.ts",
      "default": "./dist/network-guard.setup.js"
    },
    "./network-guard/preload": {
      "@argus/source": "./src/network-guard.preload.ts",
      "types": "./dist/network-guard.preload.d.ts",
      "default": "./dist/network-guard.preload.js"
    },
    "./vitest-preset": {
      "@argus/source": "./src/vitest-preset.ts",
      "types": "./dist/vitest-preset.d.ts",
      "default": "./dist/vitest-preset.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "depcruise": "depcruise --config ../../.dependency-cruiser.cjs src",
    "test:gate-g4": "vitest run test/gate-g4.test.ts",
    "test:gate-m03-g1": "vitest run test/m03-gate-g1.test.ts",
    "test:gate-m03-g2": "vitest run test/m03-gate-g2.test.ts",
    "test:gate-m03-g3": "vitest run test/m03-gate-g3.test.ts",
    "test:gate-m03-g4": "vitest run test/m03-gate-g4.test.ts",
    "test:gate-m03-g5": "vitest run test/m03-gate-g5.test.ts"
  },
  "peerDependencies": {
    "vitest": "3.2.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@typesafe-ai/sdk": "0.6.0",
    "ajv": "8.17.1",
    "fast-check": "4.10.2"
  },
  "dependencies": {
    "@argus/contracts": "workspace:*",
    "@sinclair/typebox": "0.34.52"
  }
}
