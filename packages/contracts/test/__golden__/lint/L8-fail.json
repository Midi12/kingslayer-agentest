  "script": {
    "apiVersion": "argus/v1",
    "kind": "TestScript",
    "metadata": {
      "name": "l8",
      "title": "Lint fixture l8"
    },
    "target": {
      "baseUrl": "${env.BASE_URL}",
      "viewport": {
        "width": 1920,
        "height": 1080
      },
      "locale": "en-GB",
      "timezone": "Europe/Paris"
    },
    "policy": {
      "strict": false,
      "onBreak": "escalate",
      "failOnConsoleError": false,
      "shareScreenshotsWithLlm": "on-break",
      "artifacts": "on-failure"
    },
    "handlers": [
      {
        "id": "open",
        "when": {
          "kind": "probe",
          "name": "auth_lost"
        },
        "steps": [
          {
            "id": "h-1",
            "intent": "Accept the cookies",
            "action": {
              "type": "click",
              "target": {
                "description": "Accept button of the cookie banner"
              }
            }
          }
        ]
      }
    ],
    "steps": [
      {
        "id": "open",
        "intent": "open the conveyor   overview",
        "action": {
          "type": "click",
          "target": {
            "description": "Navigation entry that opens the conveyor overview"
          }
        }
      },
      {
        "id": "start",
        "intent": "Start conveyor C12",
        "action": {
          "type": "click",
          "target": {
            "description": "Start button in the row of conveyor C12"
          }
        }
      },
      {
        "id": "start",
        "intent": "Stop conveyor C12",
        "action": {
          "type": "click",
          "target": {
            "description": "Stop button in the row of conveyor C12"
          }
        },
        "risk": "critical"
      }
    ]
  },
  "expected": [
    {
      "code": "L8",
      "stepId": "start"
    },
    {
      "code": "L8",
      "stepId": "open"
    },
    {
      "code": "L8",
      "stepId": "open"
    }
  ]
}
