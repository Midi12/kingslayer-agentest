{
  "context": {
    "criticalVerbs": [
      "delete",
      "stop",
      "reset",
      "purge",
      "emergency"
    ],
    "allowedOrigins": [
      "https://hmi.test"
    ],
    "allowedHttpHosts": [
      "sim.test:8443"
    ],
    "runTimeoutMs": 900000
  },
  "script": {
    "apiVersion": "argus/v1",
    "kind": "TestScript",
    "metadata": {
      "name": "l3-pass",
      "title": "Lint fixture l3-pass"
    },
    "target": {
      "baseUrl": "${env.BASE_URL}",
      "viewport": {
        "width": 1920,
        "height": 1080
      },
      "locale": "en-GB",
      "timezone": "Europe/Paris"
    },
    "policy": {
      "strict": false,
      "onBreak": "escalate",
      "failOnConsoleError": false,
      "shareScreenshotsWithLlm": "on-break",
      "artifacts": "on-failure"
    },
    "secrets": [
      "OPERATOR_PASSWORD",
      "SIM_TOKEN"
    ],
    "variables": {
      "conveyor": "C12"
    },
    "steps": [
      {
        "id": "s1",
        "intent": "Enter the password",
        "action": {
          "type": "fill",
          "target": {
            "description": "Password field of the login form",
            "hints": {
              "label": "Password"
            }
          },
          "value": "${secret.OPERATOR_PASSWORD}"
        }
      },
      {
        "id": "s2",
        "intent": "Trigger a jam through the simulator",
        "action": {
          "type": "http",
          "request": {
            "method": "POST",
            "url": "${env.SIM_URL}/faults",
            "headers": {
              "Authorization": "Bearer ${secret.SIM_TOKEN}"
            },
            "json": {
              "type": "jam",
              "token": "${secret.SIM_TOKEN}"
            }
          },
          "expectStatus": 202
        }
      }
    ]
  },
  "expected": []
}
