{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.dev/schemas/argus/v1/lease-request.schema.json",
  "title": "LeaseRequest",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "runnerId",
    "slotsFree",
    "labels"
  ],
  "properties": {
    "runnerId": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "slotsFree": {
      "minimum": 1,
      "type": "integer"
    },
    "labels": {
      "uniqueItems": true,
      "maxItems": 32,
      "type": "array",
      "items": {
        "pattern": "^[a-z0-9]([a-z0-9._/-]{0,62}[a-z0-9])?$",
        "type": "string"
      }
    },
    "waitSec": {
      "minimum": 0,
      "maximum": 30,
      "type": "integer"
    }
  }
}
