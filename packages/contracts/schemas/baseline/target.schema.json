{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.dev/schemas/argus/v1/target.schema.json",
  "title": "Target",
  "description": "A user-interface element named by what it is, not how to find it",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "description"
  ],
  "properties": {
    "description": {
      "minLength": 1,
      "maxLength": 500,
      "description": "Literal description of the element, used for grounding",
      "type": "string"
    },
    "hints": {
      "description": "Optional grounding hints; the description stays authoritative",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "role": {
          "minLength": 1,
          "maxLength": 64,
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        "testId": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        "near": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        },
        "region": {
          "minLength": 1,
          "maxLength": 200,
          "type": "string"
        }
      }
    },
    "frame": {
      "minLength": 1,
      "maxLength": 500,
      "description": "Name or URL fragment of the frame holding the element",
      "type": "string"
    },
    "locator": {
      "minLength": 1,
      "maxLength": 2000,
      "description": "Explicit Playwright locator; bypasses AI grounding",
      "type": "string"
    }
  }
}
