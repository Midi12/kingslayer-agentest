{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.dev/schemas/argus/v1/brain-ground-response.schema.json",
  "title": "BrainGroundResponse",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "result",
    "usage"
  ],
  "properties": {
    "result": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pick",
        "confidence",
        "probabilities",
        "targetPresent",
        "model",
        "usage",
        "latencyMs",
        "cacheHit"
      ],
      "properties": {
        "pick": {
          "description": "Candidate id, or null",
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "probabilities": {
          "additionalProperties": false,
          "type": "object",
          "patternProperties": {
            "^[A-Za-z0-9_-]{1,64}$": {
              "minimum": 0,
              "maximum": 1,
              "type": "number"
            }
          }
        },
        "targetPresent": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "confirm": {
          "additionalProperties": false,
          "type": "object",
          "patternProperties": {
            "^[A-Za-z0-9_-]{1,64}$": {
              "minimum": 0,
              "maximum": 1,
              "type": "number"
            }
          }
        },
        "model": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "usage": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "inputTokens"
          ],
          "properties": {
            "inputTokens": {
              "minimum": 0,
              "type": "integer"
            },
            "outputTokens": {
              "minimum": 0,
              "type": "integer"
            }
          }
        },
        "latencyMs": {
          "minimum": 0,
          "type": "integer"
        },
        "cacheHit": {
          "type": "boolean"
        }
      }
    },
    "usage": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "provider",
        "model",
        "calls",
        "inputTokens",
        "outputTokens",
        "billable"
      ],
      "properties": {
        "provider": {
          "anyOf": [
            {
              "const": "jev",
              "type": "string"
            },
            {
              "const": "llm",
              "type": "string"
            },
            {
              "const": "none",
              "type": "string"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "calls": {
          "minimum": 0,
          "type": "integer"
        },
        "inputTokens": {
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "minimum": 0,
          "type": "integer"
        },
        "billable": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "operation",
                "quantity"
              ],
              "properties": {
                "operation": {
                  "anyOf": [
                    {
                      "const": "step",
                      "type": "string"
                    },
                    {
                      "const": "ai_vision",
                      "type": "string"
                    },
                    {
                      "const": "escalation",
                      "type": "string"
                    },
                    {
                      "const": "report",
                      "type": "string"
                    },
                    {
                      "const": "compile",
                      "type": "string"
                    },
                    {
                      "const": "runner_minute",
                      "type": "string"
                    }
                  ]
                },
                "quantity": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
