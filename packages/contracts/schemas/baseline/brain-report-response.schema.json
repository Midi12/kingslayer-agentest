{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.dev/schemas/argus/v1/brain-report-response.schema.json",
  "title": "BrainReportResponse",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "result",
    "usage"
  ],
  "properties": {
    "result": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "summary",
        "defects",
        "adjudications",
        "heals",
        "maintenance",
        "generatedBy"
      ],
      "properties": {
        "summary": {
          "minLength": 1,
          "maxLength": 4000,
          "type": "string"
        },
        "defects": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "stepId",
              "title",
              "severity",
              "classification",
              "signature"
            ],
            "properties": {
              "id": {
                "pattern": "^def_[A-Za-z0-9_-]{1,64}$",
                "type": "string"
              },
              "stepId": {
                "pattern": "^[a-z0-9]([a-z0-9_-]{0,62}[a-z0-9])?$",
                "type": "string"
              },
              "title": {
                "minLength": 1,
                "maxLength": 200,
                "type": "string"
              },
              "severity": {
                "anyOf": [
                  {
                    "const": "critical",
                    "type": "string"
                  },
                  {
                    "const": "major",
                    "type": "string"
                  },
                  {
                    "const": "minor",
                    "type": "string"
                  },
                  {
                    "const": "trivial",
                    "type": "string"
                  }
                ]
              },
              "classification": {
                "anyOf": [
                  {
                    "const": "PRODUCT_DEFECT",
                    "type": "string"
                  },
                  {
                    "const": "TEST_DRIFT",
                    "type": "string"
                  },
                  {
                    "const": "ENVIRONMENT",
                    "type": "string"
                  },
                  {
                    "const": "TRANSIENT",
                    "type": "string"
                  }
                ]
              },
              "signature": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "sha256:<64 hex>",
                "type": "string"
              }
            }
          }
        },
        "adjudications": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "stepId",
              "decision",
              "rationale"
            ],
            "properties": {
              "stepId": {
                "pattern": "^[a-z0-9]([a-z0-9_-]{0,62}[a-z0-9])?$",
                "type": "string"
              },
              "decision": {
                "anyOf": [
                  {
                    "const": "MARK_PASSED",
                    "type": "string"
                  },
                  {
                    "const": "RESOLVE_TARGET",
                    "type": "string"
                  }
                ]
              },
              "rationale": {
                "minLength": 1,
                "maxLength": 2000,
                "type": "string"
              }
            }
          }
        },
        "heals": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "stepId",
              "status"
            ],
            "properties": {
              "stepId": {
                "pattern": "^[a-z0-9]([a-z0-9_-]{0,62}[a-z0-9])?$",
                "type": "string"
              },
              "status": {
                "anyOf": [
                  {
                    "const": "pending",
                    "type": "string"
                  },
                  {
                    "const": "approved",
                    "type": "string"
                  },
                  {
                    "const": "rejected",
                    "type": "string"
                  }
                ]
              }
            }
          }
        },
        "maintenance": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "stepId",
              "suggestion"
            ],
            "properties": {
              "stepId": {
                "anyOf": [
                  {
                    "pattern": "^[a-z0-9]([a-z0-9_-]{0,62}[a-z0-9])?$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "suggestion": {
                "minLength": 1,
                "maxLength": 2000,
                "type": "string"
              }
            }
          }
        },
        "generatedBy": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "model",
            "promptVersion"
          ],
          "properties": {
            "model": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "promptVersion": {
              "pattern": "^[a-z]-[0-9]+$",
              "type": "string"
            }
          }
        }
      }
    },
    "usage": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "provider",
        "model",
        "calls",
        "inputTokens",
        "outputTokens",
        "billable"
      ],
      "properties": {
        "provider": {
          "anyOf": [
            {
              "const": "jev",
              "type": "string"
            },
            {
              "const": "llm",
              "type": "string"
            },
            {
              "const": "none",
              "type": "string"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "calls": {
          "minimum": 0,
          "type": "integer"
        },
        "inputTokens": {
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "minimum": 0,
          "type": "integer"
        },
        "billable": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "operation",
                "quantity"
              ],
              "properties": {
                "operation": {
                  "anyOf": [
                    {
                      "const": "step",
                      "type": "string"
                    },
                    {
                      "const": "ai_vision",
                      "type": "string"
                    },
                    {
                      "const": "escalation",
                      "type": "string"
                    },
                    {
                      "const": "report",
                      "type": "string"
                    },
                    {
                      "const": "compile",
                      "type": "string"
                    },
                    {
                      "const": "runner_minute",
                      "type": "string"
                    }
                  ]
                },
                "quantity": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
