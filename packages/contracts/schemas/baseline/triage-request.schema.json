{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.dev/schemas/argus/v1/triage-request.schema.json",
  "title": "TriageRequest",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "packet",
    "frameImages"
  ],
  "properties": {
    "packet": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "runId",
        "stepId",
        "attempt",
        "reason",
        "script",
        "signals",
        "observations",
        "frames",
        "console",
        "network",
        "allowed",
        "budget"
      ],
      "properties": {
        "runId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "stepId": {
          "pattern": "^[a-z0-9]([a-z0-9_-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        "attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "const": "TARGET_NOT_FOUND",
              "type": "string"
            },
            {
              "const": "GROUNDING_AMBIGUOUS",
              "type": "string"
            },
            {
              "const": "AUTH_LOST",
              "type": "string"
            },
            {
              "const": "BLOCKING_MODAL",
              "type": "string"
            },
            {
              "const": "UNEXPECTED_ERROR_UI",
              "type": "string"
            },
            {
              "const": "ASSERTION_FAILED",
              "type": "string"
            },
            {
              "const": "VISUAL_DIFF",
              "type": "string"
            },
            {
              "const": "EXPECTATION_FAILED",
              "type": "string"
            },
            {
              "const": "EXPECTATION_UNCERTAIN",
              "type": "string"
            },
            {
              "const": "NO_EFFECT",
              "type": "string"
            },
            {
              "const": "CONSOLE_OR_NETWORK_ERROR",
              "type": "string"
            },
            {
              "const": "ACTION_ERROR",
              "type": "string"
            },
            {
              "const": "TIMEOUT",
              "type": "string"
            },
            {
              "const": "OFF_PATH",
              "type": "string"
            },
            {
              "const": "OBSERVE_FAILED",
              "type": "string"
            },
            {
              "const": "SETUP_FAILED",
              "type": "string"
            },
            {
              "const": "BUDGET_EXHAUSTED",
              "type": "string"
            },
            {
              "const": "RUNNER_LOST",
              "type": "string"
            },
            {
              "const": "ANALYST_UNAVAILABLE",
              "type": "string"
            },
            {
              "const": "ANALYST_INVALID",
              "type": "string"
            },
            {
              "const": "NAVIGATOR_UNAVAILABLE",
              "type": "string"
            }
          ]
        },
        "script": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "title",
            "stepIndex",
            "stepCount",
            "step",
            "previousIntents",
            "nextIntent"
          ],
          "properties": {
            "title": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            },
            "stepIndex": {
              "minimum": 0,
              "type": "integer"
            },
            "stepCount": {
              "minimum": 1,
              "type": "integer"
            },
            "step": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "id",
                "intent"
              ],
              "properties": {
                "id": {
                  "pattern": "^[a-z0-9]([a-z0-9_-]{0,62}[a-z0-9])?$",
                  "type": "string"
                },
                "intent": {
                  "minLength": 1,
                  "maxLength": 300,
                  "type": "string"
                },
                "action": {
                  "anyOf": [
                    {
                      "const": "navigate",
                      "type": "string"
                    },
                    {
                      "const": "click",
                      "type": "string"
                    },
                    {
                      "const": "dblclick",
                      "type": "string"
                    },
                    {
                      "const": "rightclick",
                      "type": "string"
                    },
                    {
                      "const": "hover",
                      "type": "string"
                    },
                    {
                      "const": "check",
                      "type": "string"
                    },
                    {
                      "const": "uncheck",
                      "type": "string"
                    },
                    {
                      "const": "fill",
                      "type": "string"
                    },
                    {
                      "const": "clear",
                      "type": "string"
                    },
                    {
                      "const": "select",
                      "type": "string"
                    },
                    {
                      "const": "press",
                      "type": "string"
                    },
                    {
                      "const": "upload",
                      "type": "string"
                    },
                    {
                      "const": "drag",
                      "type": "string"
                    },
                    {
                      "const": "scroll",
                      "type": "string"
                    },
                    {
                      "const": "wait",
                      "type": "string"
                    },
                    {
                      "const": "assert",
                      "type": "string"
                    },
                    {
                      "const": "extract",
                      "type": "string"
                    },
                    {
                      "const": "http",
                      "type": "string"
                    }
                  ]
                },
                "risk": {
                  "anyOf": [
                    {
                      "const": "read",
                      "type": "string"
                    },
                    {
                      "const": "write",
                      "type": "string"
                    },
                    {
                      "const": "critical",
                      "type": "string"
                    }
                  ]
                },
                "target": {
                  "description": "A user-interface element named by what it is, not how to find it",
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "description"
                  ],
                  "properties": {
                    "description": {
                      "minLength": 1,
                      "maxLength": 500,
                      "description": "Literal description of the element, used for grounding",
                      "type": "string"
                    },
                    "hints": {
                      "description": "Optional grounding hints; the description stays authoritative",
                      "additionalProperties": false,
                      "type": "object",
                      "properties": {
                        "role": {
                          "minLength": 1,
                          "maxLength": 64,
                          "type": "string"
                        },
                        "text": {
                          "minLength": 1,
                          "maxLength": 200,
                          "type": "string"
                        },
                        "label": {
                          "minLength": 1,
                          "maxLength": 200,
                          "type": "string"
                        },
                        "testId": {
                          "minLength": 1,
                          "maxLength": 200,
                          "type": "string"
                        },
                        "near": {
                          "minLength": 1,
                          "maxLength": 200,
                          "type": "string"
                        },
                        "region": {
                          "minLength": 1,
                          "maxLength": 200,
                          "type": "string"
                        }
                      }
                    },
                    "frame": {
                      "minLength": 1,
                      "maxLength": 500,
                      "description": "Name or URL fragment of the frame holding the element",
                      "type": "string"
                    },
                    "locator": {
                      "minLength": 1,
                      "maxLength": 2000,
                      "description": "Explicit Playwright locator; bypasses AI grounding",
                      "type": "string"
                    }
                  }
                }
              }
            },
            "previousIntents": {
              "maxItems": 500,
              "type": "array",
              "items": {
                "minLength": 1,
                "maxLength": 300,
                "type": "string"
              }
            },
            "nextIntent": {
              "anyOf": [
                {
                  "minLength": 1,
                  "maxLength": 300,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "signals": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "jev",
            "checks",
            "actionError",
            "elapsedMs"
          ],
          "properties": {
            "jev": {
              "additionalProperties": false,
              "type": "object",
              "patternProperties": {
                "^[a-z][a-z0-9_-]{0,80}$": {
                  "minimum": 0,
                  "maximum": 1,
                  "type": "number"
                }
              }
            },
            "checks": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind",
                  "outcome",
                  "detail"
                ],
                "properties": {
                  "kind": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "const": "noul",
                            "type": "string"
                          },
                          {
                            "const": "dom",
                            "type": "string"
                          },
                          {
                            "const": "url",
                            "type": "string"
                          },
                          {
                            "const": "color",
                            "type": "string"
                          },
                          {
                            "const": "blink",
                            "type": "string"
                          },
                          {
                            "const": "visual",
                            "type": "string"
                          },
                          {
                            "const": "vision",
                            "type": "string"
                          },
                          {
                            "const": "console",
                            "type": "string"
                          },
                          {
                            "const": "network",
                            "type": "string"
                          },
                          {
                            "const": "a11y",
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "const": "action",
                        "type": "string"
                      }
                    ]
                  },
                  "outcome": {
                    "anyOf": [
                      {
                        "const": "pass",
                        "type": "string"
                      },
                      {
                        "const": "fail",
                        "type": "string"
                      },
                      {
                        "const": "error",
                        "type": "string"
                      }
                    ]
                  },
                  "detail": {
                    "maxLength": 2000,
                    "type": "string"
                  }
                }
              }
            },
            "actionError": {
              "anyOf": [
                {
                  "maxLength": 2000,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "elapsedMs": {
              "minimum": 0,
              "type": "integer"
            }
          }
        },
        "observations": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "before",
            "after"
          ],
          "properties": {
            "before": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "digestHash"
                  ],
                  "properties": {
                    "obsId": {
                      "pattern": "^obs_[A-Za-z0-9_-]{1,64}$",
                      "type": "string"
                    },
                    "digestHash": {
                      "pattern": "^sha256:[0-9a-f]{64}$",
                      "description": "sha256:<64 hex>",
                      "type": "string"
                    },
                    "url": {
                      "maxLength": 2048,
                      "type": "string"
                    },
                    "title": {
                      "maxLength": 500,
                      "type": "string"
                    },
                    "page": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "headings",
                        "dialogs",
                        "alerts",
                        "loading",
                        "textDigest"
                      ],
                      "properties": {
                        "headings": {
                          "maxItems": 64,
                          "type": "array",
                          "items": {
                            "maxLength": 300,
                            "type": "string"
                          }
                        },
                        "dialogs": {
                          "maxItems": 16,
                          "type": "array",
                          "items": {
                            "maxLength": 1000,
                            "type": "string"
                          }
                        },
                        "alerts": {
                          "maxItems": 32,
                          "type": "array",
                          "items": {
                            "maxLength": 1000,
                            "type": "string"
                          }
                        },
                        "loading": {
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "inflightRequests",
                            "spinners"
                          ],
                          "properties": {
                            "inflightRequests": {
                              "minimum": 0,
                              "type": "integer"
                            },
                            "spinners": {
                              "minimum": 0,
                              "type": "integer"
                            }
                          }
                        },
                        "textDigest": {
                          "maxLength": 20000,
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "after": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "digestHash"
                  ],
                  "properties": {
                    "obsId": {
                      "pattern": "^obs_[A-Za-z0-9_-]{1,64}$",
                      "type": "string"
                    },
                    "digestHash": {
                      "pattern": "^sha256:[0-9a-f]{64}$",
                      "description": "sha256:<64 hex>",
                      "type": "string"
                    },
                    "url": {
                      "maxLength": 2048,
                      "type": "string"
                    },
                    "title": {
                      "maxLength": 500,
                      "type": "string"
                    },
                    "page": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "headings",
                        "dialogs",
                        "alerts",
                        "loading",
                        "textDigest"
                      ],
                      "properties": {
                        "headings": {
                          "maxItems": 64,
                          "type": "array",
                          "items": {
                            "maxLength": 300,
                            "type": "string"
                          }
                        },
                        "dialogs": {
                          "maxItems": 16,
                          "type": "array",
                          "items": {
                            "maxLength": 1000,
                            "type": "string"
                          }
                        },
                        "alerts": {
                          "maxItems": 32,
                          "type": "array",
                          "items": {
                            "maxLength": 1000,
                            "type": "string"
                          }
                        },
                        "loading": {
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "inflightRequests",
                            "spinners"
                          ],
                          "properties": {
                            "inflightRequests": {
                              "minimum": 0,
                              "type": "integer"
                            },
                            "spinners": {
                              "minimum": 0,
                              "type": "integer"
                            }
                          }
                        },
                        "textDigest": {
                          "maxLength": 20000,
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "frames": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "ref",
              "tMs"
            ],
            "properties": {
              "ref": {
                "pattern": "^art://[A-Za-z0-9._~!$&()*+,;=:@%/-]+$",
                "maxLength": 1024,
                "description": "Artifact reference, art://…",
                "type": "string"
              },
              "tMs": {
                "description": "Milliseconds relative to the break; negative is before",
                "type": "integer"
              }
            }
          }
        },
        "console": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "level",
              "text"
            ],
            "properties": {
              "level": {
                "anyOf": [
                  {
                    "const": "error",
                    "type": "string"
                  },
                  {
                    "const": "warning",
                    "type": "string"
                  },
                  {
                    "const": "info",
                    "type": "string"
                  },
                  {
                    "const": "debug",
                    "type": "string"
                  }
                ]
              },
              "text": {
                "maxLength": 4000,
                "type": "string"
              },
              "ts": {
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
                "description": "ISO 8601 timestamp with a zone",
                "type": "string"
              }
            }
          }
        },
        "network": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "method",
              "url",
              "status"
            ],
            "properties": {
              "method": {
                "minLength": 1,
                "maxLength": 16,
                "type": "string"
              },
              "url": {
                "minLength": 1,
                "maxLength": 2048,
                "type": "string"
              },
              "status": {
                "minimum": 0,
                "maximum": 999,
                "description": "0 when the request failed",
                "type": "integer"
              },
              "failure": {
                "maxLength": 500,
                "type": "string"
              },
              "ts": {
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
                "description": "ISO 8601 timestamp with a zone",
                "type": "string"
              }
            }
          }
        },
        "candidates": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "cid",
              "role",
              "name",
              "probability"
            ],
            "properties": {
              "cid": {
                "pattern": "^[A-Za-z0-9_-]{1,32}$",
                "type": "string"
              },
              "role": {
                "maxLength": 64,
                "type": "string"
              },
              "name": {
                "maxLength": 500,
                "type": "string"
              },
              "row": {
                "maxLength": 1000,
                "type": "string"
              },
              "region": {
                "maxLength": 300,
                "type": "string"
              },
              "probability": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              }
            }
          }
        },
        "allowed": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "decisions",
            "patchActions",
            "origins"
          ],
          "properties": {
            "decisions": {
              "minItems": 1,
              "uniqueItems": true,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "const": "RETRY_STEP",
                    "type": "string"
                  },
                  {
                    "const": "PATCH",
                    "type": "string"
                  },
                  {
                    "const": "RESOLVE_TARGET",
                    "type": "string"
                  },
                  {
                    "const": "MARK_PASSED",
                    "type": "string"
                  },
                  {
                    "const": "MARK_FAILED_CONTINUE",
                    "type": "string"
                  },
                  {
                    "const": "MARK_FAILED_ABORT",
                    "type": "string"
                  },
                  {
                    "const": "ABORT_ENV",
                    "type": "string"
                  }
                ]
              }
            },
            "patchActions": {
              "uniqueItems": true,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "const": "navigate",
                    "type": "string"
                  },
                  {
                    "const": "click",
                    "type": "string"
                  },
                  {
                    "const": "dblclick",
                    "type": "string"
                  },
                  {
                    "const": "rightclick",
                    "type": "string"
                  },
                  {
                    "const": "hover",
                    "type": "string"
                  },
                  {
                    "const": "check",
                    "type": "string"
                  },
                  {
                    "const": "uncheck",
                    "type": "string"
                  },
                  {
                    "const": "fill",
                    "type": "string"
                  },
                  {
                    "const": "clear",
                    "type": "string"
                  },
                  {
                    "const": "select",
                    "type": "string"
                  },
                  {
                    "const": "press",
                    "type": "string"
                  },
                  {
                    "const": "upload",
                    "type": "string"
                  },
                  {
                    "const": "drag",
                    "type": "string"
                  },
                  {
                    "const": "scroll",
                    "type": "string"
                  },
                  {
                    "const": "wait",
                    "type": "string"
                  },
                  {
                    "const": "assert",
                    "type": "string"
                  },
                  {
                    "const": "extract",
                    "type": "string"
                  },
                  {
                    "const": "http",
                    "type": "string"
                  }
                ]
              }
            },
            "origins": {
              "uniqueItems": true,
              "type": "array",
              "items": {
                "pattern": "^https?://[^/\\s?#]+$",
                "type": "string"
              }
            }
          }
        },
        "budget": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "escalationsLeft",
            "patchActionsMax"
          ],
          "properties": {
            "escalationsLeft": {
              "minimum": 0,
              "type": "integer"
            },
            "patchActionsMax": {
              "minimum": 0,
              "type": "integer"
            }
          }
        }
      }
    },
    "frameImages": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref",
          "image"
        ],
        "properties": {
          "ref": {
            "pattern": "^art://[A-Za-z0-9._~!$&()*+,;=:@%/-]+$",
            "maxLength": 1024,
            "description": "Artifact reference, art://…",
            "type": "string"
          },
          "image": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "mediaType",
              "data"
            ],
            "properties": {
              "mediaType": {
                "anyOf": [
                  {
                    "const": "image/png",
                    "type": "string"
                  },
                  {
                    "const": "image/jpeg",
                    "type": "string"
                  },
                  {
                    "const": "image/webp",
                    "type": "string"
                  }
                ]
              },
              "data": {
                "pattern": "^[A-Za-z0-9+/]*={0,2}$",
                "minLength": 4,
                "maxLength": 11184812,
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
