{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.dev/schemas/argus/v1/runner-register-response.schema.json",
  "title": "RunnerRegisterResponse",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "runnerId",
    "sessionToken",
    "expiresAt",
    "heartbeatIntervalSec",
    "leaseWaitSec"
  ],
  "properties": {
    "runnerId": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "sessionToken": {
      "minLength": 1,
      "maxLength": 8192,
      "description": "Short-lived session JWT",
      "type": "string"
    },
    "expiresAt": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "description": "ISO 8601 timestamp with a zone",
      "type": "string"
    },
    "heartbeatIntervalSec": {
      "minimum": 1,
      "type": "integer"
    },
    "leaseWaitSec": {
      "minimum": 1,
      "maximum": 30,
      "type": "integer"
    }
  }
}
