{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.dev/schemas/argus/v1/heartbeat-response.schema.json",
  "title": "HeartbeatResponse",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "expiresAt",
    "cancel"
  ],
  "properties": {
    "expiresAt": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "description": "ISO 8601 timestamp with a zone",
      "type": "string"
    },
    "cancel": {
      "type": "boolean"
    },
    "cancelReason": {
      "minLength": 1,
      "maxLength": 500,
      "type": "string"
    }
  }
}
