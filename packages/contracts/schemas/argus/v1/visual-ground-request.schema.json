{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.dev/schemas/argus/v1/visual-ground-request.schema.json",
  "title": "VisualGroundRequest",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "runId",
    "stepId",
    "step",
    "image",
    "marks"
  ],
  "properties": {
    "runId": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "stepId": {
      "pattern": "^[a-z0-9]([a-z0-9_-]{0,62}[a-z0-9])?$",
      "type": "string"
    },
    "step": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "intent",
        "target"
      ],
      "properties": {
        "intent": {
          "minLength": 1,
          "maxLength": 300,
          "type": "string"
        },
        "target": {
          "description": "A user-interface element named by what it is, not how to find it",
          "additionalProperties": false,
          "type": "object",
          "required": [
            "description"
          ],
          "properties": {
            "description": {
              "minLength": 1,
              "maxLength": 500,
              "description": "Literal description of the element, used for grounding",
              "type": "string"
            },
            "hints": {
              "description": "Optional grounding hints; the description stays authoritative",
              "additionalProperties": false,
              "type": "object",
              "properties": {
                "role": {
                  "minLength": 1,
                  "maxLength": 64,
                  "type": "string"
                },
                "text": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                },
                "label": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                },
                "testId": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                },
                "near": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                },
                "region": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                }
              }
            },
            "frame": {
              "minLength": 1,
              "maxLength": 500,
              "description": "Name or URL fragment of the frame holding the element",
              "type": "string"
            },
            "locator": {
              "minLength": 1,
              "maxLength": 2000,
              "description": "Explicit Playwright locator; bypasses AI grounding",
              "type": "string"
            }
          }
        }
      }
    },
    "image": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "mediaType",
        "data"
      ],
      "properties": {
        "mediaType": {
          "anyOf": [
            {
              "const": "image/png",
              "type": "string"
            },
            {
              "const": "image/jpeg",
              "type": "string"
            },
            {
              "const": "image/webp",
              "type": "string"
            }
          ]
        },
        "data": {
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "minLength": 4,
          "maxLength": 11184812,
          "type": "string"
        }
      }
    },
    "marks": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mark"
        ],
        "properties": {
          "mark": {
            "pattern": "^[0-9]{1,3}$",
            "type": "string"
          },
          "label": {
            "maxLength": 300,
            "type": "string"
          }
        }
      }
    }
  }
}
