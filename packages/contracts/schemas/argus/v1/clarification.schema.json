{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.dev/schemas/argus/v1/clarification.schema.json",
  "title": "Clarification",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "question",
    "stepId"
  ],
  "properties": {
    "id": {
      "pattern": "^q[0-9]{1,3}$",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "maxLength": 1000,
      "type": "string"
    },
    "stepId": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9]([a-z0-9_-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceExcerpt": {
      "minLength": 1,
      "maxLength": 1000,
      "type": "string"
    },
    "options": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 300,
        "type": "string"
      }
    }
  }
}
