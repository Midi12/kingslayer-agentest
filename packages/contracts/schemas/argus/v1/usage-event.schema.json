{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.dev/schemas/argus/v1/usage-event.schema.json",
  "title": "UsageEvent",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "orgId",
    "projectId",
    "runId",
    "operation",
    "quantity",
    "aiMode",
    "modelTier",
    "rate",
    "credits",
    "ts"
  ],
  "properties": {
    "id": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "orgId": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "projectId": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "runId": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "anyOf": [
        {
          "const": "step",
          "type": "string"
        },
        {
          "const": "ai_vision",
          "type": "string"
        },
        {
          "const": "escalation",
          "type": "string"
        },
        {
          "const": "report",
          "type": "string"
        },
        {
          "const": "compile",
          "type": "string"
        },
        {
          "const": "runner_minute",
          "type": "string"
        }
      ]
    },
    "quantity": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "aiMode": {
      "anyOf": [
        {
          "const": "managed",
          "type": "string"
        },
        {
          "const": "byo",
          "type": "string"
        }
      ]
    },
    "modelTier": {
      "anyOf": [
        {
          "const": "standard",
          "type": "string"
        },
        {
          "const": "premium",
          "type": "string"
        }
      ]
    },
    "runnerKind": {
      "anyOf": [
        {
          "const": "cloud",
          "type": "string"
        },
        {
          "const": "self-hosted",
          "type": "string"
        },
        {
          "const": "ephemeral",
          "type": "string"
        }
      ]
    },
    "rate": {
      "minimum": 0,
      "description": "Credits per unit, as applied",
      "type": "number"
    },
    "credits": {
      "minimum": 0,
      "type": "number"
    },
    "ts": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "description": "ISO 8601 timestamp with a zone",
      "type": "string"
    }
  }
}
